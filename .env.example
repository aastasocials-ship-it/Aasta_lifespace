# Resend (https://resend.com) — used by api/send-email.ts for all website forms.
# Copy to .env.local for local dev; add the same variables in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend. Until then, use: Aasta Lifespace Website <onboarding@resend.dev>
RESEND_FROM_EMAIL=Aasta Lifespace Website <website@aastalifespace.com>
# Where form submissions are delivered (comma-separate multiple addresses).
# Until a domain is verified in Resend, only the Resend account email works.
# After verifying: CONTACT_TO_EMAIL=studio@aastalifespace.com,aastasocials@gmail.com
CONTACT_TO_EMAIL=aastasocials@gmail.com
